{
  "name": "@erilog/reconcile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./browser": {
      "import": "./dist/browser.js",
      "types": "./dist/browser.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@erilog/crypto": "workspace:*",
    "@erilog/schemas": "workspace:*"
  },
  "devDependencies": {
    "@types/archiver": "6.0.3",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "archiver": "7.0.1",
    "fast-check": "3.23.2",
    "pg": "^8.23.0",
    "typescript": "5.8.3",
    "vitest": "3.2.3",
    "yauzl-promise": "^4.0.0"
  }
}
