{
  "name": "@erilog/verifier",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./core": {
      "import": "./dist/verifier.js",
      "types": "./dist/verifier.d.ts"
    },
    "./tamper-lab": {
      "import": "./dist/tamper-lab.js",
      "types": "./dist/tamper-lab.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@erilog/crypto": "workspace:*",
    "@erilog/reconcile": "workspace:*",
    "@erilog/schemas": "workspace:*",
    "yauzl-promise": "4.0.0"
  },
  "devDependencies": {
    "@types/archiver": "6.0.3",
    "@types/node": "22.15.32",
    "@types/yauzl-promise": "4.0.1",
    "archiver": "7.0.1",
    "typescript": "5.8.3",
    "vitest": "3.2.3"
  }
}
